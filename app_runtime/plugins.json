{
  "version": 1,
  "node": "custom_ros_nodelet_manager",
  "defaults": {
    "library_dir": "lib"
  },
  "plugins": [
    {
      "name": "/talker",
      "class": "talker_nodelet::TalkerNodelet",
      "library": "libtalker_nodelet.so",
      "enabled": true,
      "remap": {},
      "args": []
    },
    {
      "name": "/listener",
      "class": "listener_nodelet::ListenerNodelet",
      "library": "liblistener_nodelet.so",
      "enabled": true,
      "remap": {},
      "args": []
    },
    {
      "name": "/slam2d",
      "class": "slam2d_nodelet::Slam2dNodelet",
      "library": "libslam2d_nodelet.so",
      "enabled": true,
      "remap": {
        "/slam2d/scan": "/mycar/base_scan",
        "/slam2d/odom": "/mycar/odom",
        "/slam2d/reset": "/slam2d/reset"
      },
      "args": []
    }
  ]
}
