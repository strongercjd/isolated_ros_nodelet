{
  "version": 1,
  "node": "custom_ros_nodelet_manager",
  "defaults": {
    "library_dir": "lib"
  },
  "plugins": [
    {
      "name": "/talker",
      "class": "talker_nodelet::TalkerNodelet",
      "library": "libtalker_nodelet.so",
      "enabled": true,
      "remap": {},
      "args": []
    },
    {
      "name": "/listener",
      "class": "listener_nodelet::ListenerNodelet",
      "library": "liblistener_nodelet.so",
      "enabled": true,
      "remap": {},
      "args": []
    }
  ]
}
