# =============================================================================
# mycar.frobot —— flat_sim 机器人模型：圆形差速小车 + 车顶激光
# 半径 0.1m（≈ 0.2m×0.2m 外形）。
#
# 约定：长度米(m)、角度度(deg)；pose 为世界系缺省初始位姿（可被 world 覆盖）。
# 所有 # 备注在加载时全部丢弃。
# =============================================================================

robot:
  name: mycar             # 亦用作话题前缀 /mycar/...
  shape: circle           # 首期仅支持 circle
  radius: 0.1             # 半径 0.1 m
  pose: [0, 0, 0]         # 缺省初始位姿（world 里 robot_file 下可覆盖）
  drive: diff             # 差速驱动
  color: red              # 仅显示用，可无

  laser:
    # 激光在车体中心上方投影位置；相对车体，前方 0、朝向与车体一致
    pose: [0, 0, 0]
    range: [0.0, 10.0]
    fov_deg: 360          # 360° 全向激光（angle_min/max = ±180°）
    samples: 361
